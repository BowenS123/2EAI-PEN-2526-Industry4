<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MQTT" Id="{270871cb-0a35-4144-bff4-6b125c1b4a84}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MQTT
VAR_INPUT
	bTransportbandRunning	: BOOL;
	bTransportbandDone		: BOOL;
	bSystemError			: BOOL;
	{attribute 'TcEncoding':='UTF-8'}
	sErrorMessage			: STRING(255);
END_VAR

VAR_OUTPUT
	bRemoteStart			: BOOL;
	bRemoteStop			: BOOL;
END_VAR

VAR
	fbMqttClient			: FB_IotMqttClient;
	fbMessageQueue			: FB_IotMqttMessageQueue;
	fbMessage				: FB_IotMqttMessage;
	fbPublishTimer			: TON := (PT := T#1S);

	bMqttConfigured			: BOOL := FALSE;
	bSubscribedRobotCmd		: BOOL := FALSE;
	bSubscribedRobotState	: BOOL := FALSE;
	bSubscribedRobotError	: BOOL := FALSE;
	bSubscribedMixerCmd		: BOOL := FALSE;
	bSubscribedMixerState	: BOOL := FALSE;
	bSubscribedMixerError	: BOOL := FALSE;
	bSubscribedTransportCmd	: BOOL := FALSE;

	{attribute 'TcEncoding':='UTF-8'}
	sPayloadRcv			: STRING(255);
	{attribute 'TcEncoding':='UTF-8'}
	sPayloadPub			: STRING(255);
	{attribute 'TcEncoding':='UTF-8'}
	sTransportState			: STRING(64);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bMqttConfigured THEN
	bMqttConfigured := TRUE;
	fbMqttClient.sHostName := GVL_MQTT.sMqttBroker;
	fbMqttClient.nHostPort := GVL_MQTT.nMqttPort;
	fbMqttClient.sClientId := GVL_MQTT.sMqttClientID;
	fbMqttClient.ipMessageQueue := fbMessageQueue;
END_IF

fbMqttClient.Execute(bConnect := GVL_MQTT.bEnableMqtt);
GVL_MQTT.bMqttConnected := fbMqttClient.bConnected;

IF fbMqttClient.bConnected THEN
	IF NOT bSubscribedRobotCmd THEN
		bSubscribedRobotCmd := fbMqttClient.Subscribe(
			sTopic := GVL_MQTT.sTopicRobotCmd,
			eQoS := TcIotMqttQos.AtMostOnceDelivery
		);
	END_IF

	IF NOT bSubscribedRobotState THEN
		bSubscribedRobotState := fbMqttClient.Subscribe(
			sTopic := GVL_MQTT.sTopicRobotState,
			eQoS := TcIotMqttQos.AtMostOnceDelivery
		);
	END_IF

	IF NOT bSubscribedRobotError THEN
		bSubscribedRobotError := fbMqttClient.Subscribe(
			sTopic := GVL_MQTT.sTopicRobotError,
			eQoS := TcIotMqttQos.AtMostOnceDelivery
		);
	END_IF

	IF NOT bSubscribedMixerCmd THEN
		bSubscribedMixerCmd := fbMqttClient.Subscribe(
			sTopic := GVL_MQTT.sTopicMixerCmd,
			eQoS := TcIotMqttQos.AtMostOnceDelivery
		);
	END_IF

	IF NOT bSubscribedMixerState THEN
		bSubscribedMixerState := fbMqttClient.Subscribe(
			sTopic := GVL_MQTT.sTopicMixerState,
			eQoS := TcIotMqttQos.AtMostOnceDelivery
		);
	END_IF

	IF NOT bSubscribedMixerError THEN
		bSubscribedMixerError := fbMqttClient.Subscribe(
			sTopic := GVL_MQTT.sTopicMixerError,
			eQoS := TcIotMqttQos.AtMostOnceDelivery
		);
	END_IF

	IF NOT bSubscribedTransportCmd THEN
		bSubscribedTransportCmd := fbMqttClient.Subscribe(
			sTopic := GVL_MQTT.sTopicTransportbandCmd,
			eQoS := TcIotMqttQos.AtMostOnceDelivery
		);
	END_IF

	fbPublishTimer(IN := TRUE);
	IF fbPublishTimer.Q THEN
		fbPublishTimer(IN := FALSE);

		IF bSystemError THEN
			sTransportState := 'error';
		ELSIF bTransportbandRunning THEN
			sTransportState := 'running';
		ELSIF bTransportbandDone THEN
			sTransportState := 'done';
		ELSE
			sTransportState := 'idle';
		END_IF

		sPayloadPub := CONCAT('{"state":"', sTransportState);
		sPayloadPub := CONCAT(sPayloadPub, '"}');

		fbMqttClient.Publish(
			sTopic := GVL_MQTT.sTopicTransportbandState,
			pPayload := ADR(sPayloadPub),
			nPayloadSize := TO_UDINT(LEN(sPayloadPub) + 1),
			eQoS := TcIotMqttQos.AtMostOnceDelivery,
			bRetain := FALSE,
			bQueue := FALSE
		);

		IF bSystemError THEN
			sPayloadPub := CONCAT('{"state":"error","error":true,"message":"', sErrorMessage);
			sPayloadPub := CONCAT(sPayloadPub, '"}');
		ELSE
			sPayloadPub := '{"state":"ok","error":false,"message":""}';
		END_IF

		fbMqttClient.Publish(
			sTopic := GVL_MQTT.sTopicTransportbandError,
			pPayload := ADR(sPayloadPub),
			nPayloadSize := TO_UDINT(LEN(sPayloadPub) + 1),
			eQoS := TcIotMqttQos.AtMostOnceDelivery,
			bRetain := FALSE,
			bQueue := FALSE
		);
	END_IF
ELSE
	bSubscribedRobotCmd := FALSE;
	bSubscribedRobotState := FALSE;
	bSubscribedRobotError := FALSE;
	bSubscribedMixerCmd := FALSE;
	bSubscribedMixerState := FALSE;
	bSubscribedMixerError := FALSE;
	bSubscribedTransportCmd := FALSE;
	fbPublishTimer(IN := FALSE);
END_IF

// Remote commando's als puls per PLC-cyclus
bRemoteStart := FALSE;
bRemoteStop := FALSE;

IF fbMessageQueue.nQueuedMessages > 0 THEN
	IF fbMessageQueue.Dequeue(fbMessage := fbMessage) THEN
		fbMessage.GetPayload(
			pPayload := ADR(sPayloadRcv),
			nPayloadSize := SIZEOF(sPayloadRcv),
			bSetNullTermination := FALSE
		);

		IF fbMessage.CompareTopic(sTopic := GVL_MQTT.sTopicRobotCmd) THEN
			GVL_MQTT.sRobotCmdRaw := sPayloadRcv;
			GVL_MQTT.sRobotCmdDisplay := sPayloadRcv;
		ELSIF fbMessage.CompareTopic(sTopic := GVL_MQTT.sTopicRobotState) THEN
			GVL_MQTT.sRobotStateRaw := sPayloadRcv;
			GVL_MQTT.sRobotStateDisplay := F_ParseStateDisplay(sPayload := sPayloadRcv);
		ELSIF fbMessage.CompareTopic(sTopic := GVL_MQTT.sTopicRobotError) THEN
			GVL_MQTT.sRobotErrorRaw := sPayloadRcv;
			GVL_MQTT.sRobotErrorDisplay := F_ParseErrorDisplay(sPayload := sPayloadRcv);
		ELSIF fbMessage.CompareTopic(sTopic := GVL_MQTT.sTopicMixerCmd) THEN
			GVL_MQTT.sMixerCmdRaw := sPayloadRcv;
			GVL_MQTT.sMixerCmdDisplay := sPayloadRcv;
		ELSIF fbMessage.CompareTopic(sTopic := GVL_MQTT.sTopicMixerState) THEN
			GVL_MQTT.sMixerStateRaw := sPayloadRcv;
			GVL_MQTT.sMixerStateDisplay := F_ParseStateDisplay(sPayload := sPayloadRcv);
		ELSIF fbMessage.CompareTopic(sTopic := GVL_MQTT.sTopicMixerError) THEN
			GVL_MQTT.sMixerErrorRaw := sPayloadRcv;
			GVL_MQTT.sMixerErrorDisplay := F_ParseErrorDisplay(sPayload := sPayloadRcv);
		ELSIF fbMessage.CompareTopic(sTopic := GVL_MQTT.sTopicTransportbandCmd) THEN
			GVL_MQTT.sTransportbandCmdRaw := sPayloadRcv;

			IF (sPayloadRcv = '{"cmd":"stop"}') OR (sPayloadRcv = '{"cmd":"STOP"}') OR (sPayloadRcv = 'stop') OR (sPayloadRcv = 'STOP') THEN
				bRemoteStart := FALSE;
				bRemoteStop := TRUE;
			ELSIF (sPayloadRcv = '{"cmd":"start"}') OR (sPayloadRcv = '{"cmd":"START"}') OR (sPayloadRcv = 'start') OR (sPayloadRcv = 'START') THEN
				bRemoteStart := TRUE;
				bRemoteStop := FALSE;
			END_IF
		END_IF
	END_IF
END_IF]]></ST>
    </Implementation>
    <LineIds Name="FB_MQTT">
      <LineId Id="9" Count="0" />
      <LineId Id="4" Count="4" />
      <LineId Id="120" Count="0" />
      <LineId Id="10" Count="109" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>