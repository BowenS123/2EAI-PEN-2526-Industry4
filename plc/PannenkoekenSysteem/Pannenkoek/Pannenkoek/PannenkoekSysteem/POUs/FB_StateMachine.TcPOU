<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_StateMachine" Id="{734d8fb6-0da9-4e7f-80a6-9c9e670df0f1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StateMachine

VAR_INPUT
    bStart 				: BOOL;   // start knop
    bStop  				: BOOL;   // stop knop
    bError 				: BOOL;   // fouten
	bTransportbandStart	: BOOL;
END_VAR

VAR_OUTPUT
    eStateOut       : E_MainState; // Huidige state zichtbaar buiten
END_VAR

VAR
    eState : E_MainState := E_MainState.INIT;  // Interne state
	FB_Transportband     :	FB_Transportband;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE eState OF
	E_MainState.INIT:
		eState := E_MainState.IDLE;
		
	E_MainState.IDLE:
		IF bStart THEN
            eState := E_MainState.RUNNING;
        END_IF
	
	E_MainState.RUNNING:
	    FB_Transportband(
			bStart := TRUE,  // RUNNING → start band
			bStop  := bStop  // stop / noodstop
    	);
		
		bTransportbandStart := FB_Transportband.bRunning;
		
		(*
		IF FB_Transportband.bDone THEN
		END_IF
		*)
		
		IF bStop THEN
            eState := E_MainState.STOPPING;
        ELSIF bError THEN
            eState := E_MainState.ERROR;
        END_IF
		
	E_MainState.STOPPING:
		eState := E_MainState.IDLE;
	
	E_MainState.ERROR:
	    IF NOT bError THEN
            eState := E_MainState.IDLE;
        END_IF
END_CASE

// Huidige state beschikbaar maken
eStateOut := eState;]]></ST>
    </Implementation>
