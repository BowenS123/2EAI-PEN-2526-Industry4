/Value></Property><Property><Name>Namespace</Name><Value>VN</Value></Property></Properties></Parameter></Method><Method><Name>GetCurrentImage</Name><Comment><![CDATA[ Gets the current available image (first in receive queue). ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>ipImage</Name><Comment><![CDATA[ Returns the image ]]></Comment><Type GUID="{70D42C6D-6F4E-4719-8B29-2883D5D59B1C}" ReferenceTo="true">ITcVnImage</Type><BitSize>64</BitSize><Properties><Property><Name>GUID</Name><Value>70D42C6D-6F4E-4719-8B29-2883D5D59B1C</Value></Property></Properties></Parameter></Method><Method><Name>GetState</Name><Comment><![CDATA[ Gets the current state of the internal camera control state machine. ]]></Comment><ReturnType Namespace="Tc3_Vision">ETcVnCameraState</ReturnType><ReturnBitSize>32</ReturnBitSize></Method><Method><Name>GetCurrentImageUndistorted</Name><Comment><![CDATA[ Gets the current available image (first in receive queue) with undistortion applied. Incompatible with pixel formats that contain an encoding, e.g. a Bayer pattern. Requires intrinsic calibration parameters in the TcVnGevImageProvider TcCOM module, e.g. set by the calibration assistant. ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>ipImage</Name><Comment><![CDATA[ Returns the undistorted image ]]></Comment><Type GUID="{70D42C6D-6F4E-4719-8B29-2883D5D59B1C}" ReferenceTo="true">ITcVnImage</Type><BitSize>64</BitSize><Properties><Property><Name>GUID</Name><Value>70D42C6D-6F4E-4719-8B29-2883D5D59B1C</Value></Property></Properties></Parameter></Method><Method><Name>GetRotationMatrix</Name><Comment><![CDATA[ Gets the rotation matrix from the TcVnGevImageProvider TcCOM module (requires extrinsic calibration parameters, e.g. set by the calibration assistant) ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>aRotationMatrix</Name><Comment><![CDATA[ Returns the rotation matrix ]]></Comment><Type GUID="{91A420A3-4727-4481-B3BB-170528E5BC7C}" Namespace="VN" ReferenceTo="true">TcVnMatrix3x3_LREAL</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property><Property><Name>GUID</Name><Value>91A420A3-4727-4481-B3BB-170528E5BC7C</Value></Property><Property><Name>Namespace</Name><Value>VN</Value></Property></Properties></Parameter></Method><Method><Name>SetDistortionCoefficients</Name><Comment><![CDATA[ Sets the distortion coefficients to the TcVnGevImageProvider TcCOM module ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>aDistortionCoefficients</Name><Comment><![CDATA[ The distortion coefficients to be copied to the TcCOM module ]]></Comment><Type GUID="{DD112102-C23A-4B37-A43A-A96400B57010}" Namespace="VN" ReferenceTo="true">TcVnArray8_LREAL</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property><Property><Name>GUID</Name><Value>DD112102-C23A-4B37-A43A-A96400B57010</Value></Property><Property><Name>Namespace</Name><Value>VN</Value></Property></Properties></Parameter></Method><Method><Name>GetDistortionCoefficients</Name><Comment><![CDATA[ Gets the distortion coefficients from the TcVnGevImageProvider TcCOM module (requires intrinsic calibration parameters, e.g. set by the calibration assistant) ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>aDistortionCoefficients</Name><Comment><![CDATA[ Returns the distortion coefficients [k1, k2, p1, p2, k3, k4, k5, k6] ]]></Comment><Type GUID="{DD112102-C23A-4B37-A43A-A96400B57010}" Namespace="VN" ReferenceTo="true">TcVnArray8_LREAL</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property><Property><Name>GUID</Name><Value>DD112102-C23A-4B37-A43A-A96400B57010</Value></Property><Property><Name>Namespace</Name><Value>VN</Value></Property></Properties></Parameter></Method><Method><Name>GetCurrentImageWithTimestamps</Name><Comment><![CDATA[ Gets the current available image (first in receive queue) and corresponding timestamps. ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>ipImage</Name><Comment><![CDATA[ Returns the image ]]></Comment><Type GUID="{70D42C6D-6F4E-4719-8B29-2883D5D59B1C}" ReferenceTo="true">ITcVnImage</Type><BitSize>64</BitSize><Properties><Property><Name>GUID</Name><Value>70D42C6D-6F4E-4719-8B29-2883D5D59B1C</Value></Property></Properties></Parameter><Parameter><Name>nTimestamps</Name><Comment><![CDATA[ Select timestamps to return (combine several ETcVnTimestamp values with bitwise OR) ]]></Comment><Type>ULINT</Type><BitSize>64</BitSize></Parameter><Parameter><Name>pTimestamps</Name><Comment><![CDATA[ Returns the requested timestamps (make sure to provide an array of sufficient size). ]]></Comment><Type PointerTo="1">LINT</Type><BitSize>64</BitSize></Parameter><Parameter><Name>stGvspInfo</Name><Comment><![CDATA[ Returns the GVSP info ]]></Comment><Type GUID="{63FC7E33-91CD-44CD-9015-0BD1DC25722C}">GVSP_IMAGE_INFO</Type><BitSize>448</BitSize><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property><Property><Name>GUID</Name><Value>63FC7E33-91CD-44CD-9015-0BD1DC25722C</Value></Property></Properties></Parameter></Method><Method><Name>GetCurrentImageWithGvspInfo</Name><Comment><![CDATA[ Gets the current available image (first in receive queue) and its corresponding GVSP info. ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>ipImage</Name><Comment><![CDATA[ Returns the image ]]></Comment><Type GUID="{70D42C6D-6F4E-4719-8B29-2883D5D59B1C}" ReferenceTo="true">ITcVnImage</Type><BitSize>64</BitSize><Properties><Property><Name>GUID</Name><Value>70D42C6D-6F4E-4719-8B29-2883D5D59B1C</Value></Property></Properties></Parameter><Parameter><Name>stGvspInfo</Name><Comment><![CDATA[ Returns the GVSP info ]]></Comment><Type GUID="{63FC7E33-91CD-44CD-9015-0BD1DC25722C}" ReferenceTo="true">GVSP_IMAGE_INFO</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property><Property><Name>GUID</Name><Value>63FC7E33-91CD-44CD-9015-0BD1DC25722C</Value></Property></Properties></Parameter></Method><Method><Name>GetCurrentImageWithGvspInfoUndistorted</Name><Comment><![CDATA[ Gets the current available image (first in receive queue) with its corresponding GVSP info and undistortion applied. Incompatible with pixel formats that contain an encoding, e.g. a Bayer pattern. Requires intrinsic calibration parameters in the TcVnGevImageProvider TcCOM module, e.g. set by the calibration assistant. ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>ipImage</Name><Comment><![CDATA[ Returns the undistorted image ]]></Comment><Type GUID="{70D42C6D-6F4E-4719-8B29-2883D5D59B1C}" ReferenceTo="true">ITcVnImage</Type><BitSize>64</BitSize><Properties><Property><Name>GUID</Name><Value>70D42C6D-6F4E-4719-8B29-2883D5D59B1C</Value></Property></Properties></Parameter><Parameter><Name>stGvspInfo</Name><Comment><![CDATA[ Returns the GVSP info ]]></Comment><Type GUID="{63FC7E33-91CD-44CD-9015-0BD1DC25722C}" ReferenceTo="true">GVSP_IMAGE_INFO</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property><Property><Name>GUID</Name><Value>63FC7E33-91CD-44CD-9015-0BD1DC25722C</Value></Property></Properties></Parameter></Method><Method><Name>Reset</Name><Comment><![CDATA[ Reset the camera controller to initial state (might require multiple calls depending on current state, until S_OK is returned) ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize></Method><Method><Name>GetCameraMatrix</Name><Comment><![CDATA[ Gets the camera matrix from the TcVnGevImageProvider TcCOM module (requires intrinsic calibration parameters, e.g. set by the calibration assistant) ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>aCameraMatrix</Name><Comment><![CDATA[ Returns the camera matrix ]]></Comment><Type GUID="{91A420A3-4727-4481-B3BB-170528E5BC7C}" Namespace="VN" ReferenceTo="true">TcVnMatrix3x3_LREAL</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property><Property><Name>GUID</Name><Value>91A420A3-4727-4481-B3BB-170528E5BC7C</Value></Property><Property><Name>Namespace</Name><Value>VN</Value></Property></Properties></Parameter></Method><Method><Name>SetTranslationVector</Name><Comment><![CDATA[ Sets the translation vector to the TcVnGevImageProvider TcCOM module ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>aTranslationVector</Name><Comment><![CDATA[ The translation vector to be copied to the TcCOM module ]]></Comment><Type GUID="{B9A67DEB-A7D1-4F25-95A3-4A82FA5C1E28}" Namespace="VN" ReferenceTo="true">TcVnVector3_LREAL</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property><Property><Name>GUID</Name><Value>B9A67DEB-A7D1-4F25-95A3-4A82FA5C1E28</Value></Property><Property><Name>Namespace</Name><Value>VN</Value></Property></Properties></Parameter></Method><Method><Name>GetImageQueueSize</Name><Comment><![CDATA[ Gets the current number of images in the receive queue. ]]></Comment><ReturnType GUID="{18071995-0000-0000-0000-000000000019}">HRESULT</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter>